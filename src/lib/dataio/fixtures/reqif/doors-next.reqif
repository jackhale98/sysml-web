            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>_ad_r_text</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><xhtml:div xmlns:xhtml="http://www.w3.org/1999/xhtml"><xhtml:p>The drone shall hover for at least <xhtml:b>20 minutes</xhtml:b> with a 1&#160;kg payload.</xhtml:p><xhtml:p>Conditions:</xhtml:p><xhtml:ul><xhtml:li>still air,</xhtml:li><xhtml:li>15 &#176;C at sea level.</xhtml:li></xhtml:ul></xhtml:div></THE-VALUE>
