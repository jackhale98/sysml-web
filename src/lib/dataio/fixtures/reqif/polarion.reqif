        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="ID_DRN-12" LAST-CHANGE="2026-10-01T16:40:12.000+02:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="DRN-12"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_sw_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Attitude loop rate"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_sw_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>ID_AD_sw_description</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The attitude controller shall run at <reqif-xhtml:span style="font-weight: bold;">400 Hz</reqif-xhtml:span> or faster, and:</reqif-xhtml:p><reqif-xhtml:ol><reqif-xhtml:li>read the IMU every cycle;</reqif-xhtml:li><reqif-xhtml:li>log a missed deadline.</reqif-xhtml:li></reqif-xhtml:ol></reqif-xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>ID_AD_sw_status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>ID_EV_status_approved</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>ID_AD_sw_severity</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>ID_EV_sev_must</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="m.weber"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_sw_author</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-BOOLEAN THE-VALUE="true"><DEFINITION><ATTRIBUTE-DEFINITION-BOOLEAN-REF>ID_AD_sw_safety</ATTRIBUTE-DEFINITION-BOOLEAN-REF></DEFINITION></ATTRIBUTE-VALUE-BOOLEAN>
            <ATTRIBUTE-VALUE-REAL THE-VALUE="3.5"><DEFINITION><ATTRIBUTE-DEFINITION-REAL-REF>ID_AD_sw_effort</ATTRIBUTE-DEFINITION-REAL-REF></DEFINITION></ATTRIBUTE-VALUE-REAL>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>ID_SOT_softwareRequirement</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="ID_DRN-13" LAST-CHANGE="2026-10-01T16:40:12.000+02:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="DRN-13"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_sw_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Motor output limits"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_sw_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>ID_AD_sw_description</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>The mixer shall keep each motor command within the limits below.</reqif-xhtml:p><reqif-xhtml:table><reqif-xhtml:tbody><reqif-xhtml:tr><reqif-xhtml:th>Limit</reqif-xhtml:th><reqif-xhtml:th>Value</reqif-xhtml:th></reqif-xhtml:tr><reqif-xhtml:tr><reqif-xhtml:td>Minimum</reqif-xhtml:td><reqif-xhtml:td>5 %</reqif-xhtml:td></reqif-xhtml:tr><reqif-xhtml:tr><reqif-xhtml:td>Maximum</reqif-xhtml:td><reqif-xhtml:td>95 %</reqif-xhtml:td></reqif-xhtml:tr></reqif-xhtml:tbody></reqif-xhtml:table></reqif-xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>ID_AD_sw_status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>ID_EV_status_draft</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>ID_AD_sw_severity</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>ID_EV_sev_should</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-BOOLEAN THE-VALUE="false"><DEFINITION><ATTRIBUTE-DEFINITION-BOOLEAN-REF>ID_AD_sw_safety</ATTRIBUTE-DEFINITION-BOOLEAN-REF></DEFINITION></ATTRIBUTE-VALUE-BOOLEAN>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>ID_SOT_softwareRequirement</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="ID_DRN-14" LAST-CHANGE="2026-10-01T16:40:12.000+02:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="DRN-14"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_sw_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Motor saturation alarm"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_sw_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>ID_AD_sw_description</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION>
              <THE-VALUE><reqif-xhtml:div><reqif-xhtml:p>When a motor command has been at its maximum for more than 2 s, the software shall raise a saturation alarm.</reqif-xhtml:p></reqif-xhtml:div></THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>ID_AD_sw_status</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>ID_EV_status_reviewed</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
            <ATTRIBUTE-VALUE-ENUMERATION><DEFINITION><ATTRIBUTE-DEFINITION-ENUMERATION-REF>ID_AD_sw_severity</ATTRIBUTE-DEFINITION-ENUMERATION-REF></DEFINITION><VALUES><ENUM-VALUE-REF>ID_EV_sev_nice</ENUM-VALUE-REF></VALUES></ATTRIBUTE-VALUE-ENUMERATION>
          </VALUES>
          <TYPE><SPEC-OBJECT-TYPE-REF>ID_SOT_softwareRequirement</SPEC-OBJECT-TYPE-REF></TYPE>
        </SPEC-OBJECT>
