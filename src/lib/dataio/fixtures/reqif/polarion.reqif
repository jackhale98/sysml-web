        <SPEC-OBJECT IDENTIFIER="ID_DRN-1" LAST-CHANGE="2026-10-01T16:40:12.000+02:00">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="DRN-1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_heading_id</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Flight control software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ID_AD_heading_title</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
          </VALUES>
