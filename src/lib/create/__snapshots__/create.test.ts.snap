// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`a new trade study > compares parts and part defs on weighted criteria, ranked as the engine reads it 1`] = `
"package MotorChoice {
    doc /* Which motor should the rover use? */

    private import ScalarValues::Real;
    private import TradeStudies::*;
    private import ISQ::*;
    private import SI::*;
    private import Rover::Motor;
    private import Rover::SmallMotor;
    private import Rover::BigMotor;
    private import Rover::system;
    private import Rover::spare;

    // The candidates: each a part of its own kind, so the study can compare them.
    variation part motorOptions : Motor {
        variant part smallMotor : SmallMotor;
        variant part bigMotor : BigMotor;
    }

    calc def MotorChoiceScore {
        doc /* Each criterion is scored from 0 (worst) to 1 (best) and weighted: mass 30 %, price 30 %, power 40 %. An alternative with a price over 170 scores 0. */
        in mass : MassValue;
        in price : Real;
        in power : PowerValue;
        attribute massScore : Real = (2 [kg] - mass) / 0.8 [kg];  // 2 kg: 0, 1.2 kg: 1
        attribute priceScore : Real = (180.0 - price) / 90.0;  // 180: 0, 90: 1
        attribute powerScore : Real = (power - 300 [W]) / 200 [W];  // 300 W: 0, 500 W: 1
        return score : Real = if price > 170.0 ? 0.0 else 0.3 * massScore + 0.3 * priceScore + 0.4 * powerScore;
    }

    analysis motorChoiceStudy : TradeStudy {
        doc /* Which motor should the rover use? */
        subject : Motor[4] = (system.motor, spare, motorOptions::smallMotor, motorOptions::bigMotor);
        objective : MaximizeObjective;

        calc :>> evaluationFunction {
            in part motor :>> alternative : Motor;
            attribute mass : MassValue = motor.mass;
            attribute price : Real = motor.price;
            attribute power : PowerValue = motor.power;
            return :>> result : Real = MotorChoiceScore(mass, price, power);
        }

        return part :>> selectedAlternative : Motor;
    }
}
"
`;
